# Copie este arquivo para backend/.env e preencha localmente.
# Não coloque usuário, senha ou URI real neste exemplo.
MONGODB_URI=
# Obrigatória em produção (Vercel): transcrição Whisper + revisão + análise.
GROQ_API_KEY=
# Opcional. Padrão: whisper-large-v3-turbo. Para mais acurácia: whisper-large-v3.
# SOPHIA_WHISPER_MODEL=whisper-large-v3-turbo

# IA da análise preliminar, do chat e das minutas (chave só no servidor, nunca no navegador).
# Provedor: groq (padrão) | openai | anthropic | google. A chave é <PROVEDOR>_API_KEY.
SOPHIA_LLM_PROVIDER=groq
# GROQ_API_KEY já está acima. Para outro provedor: OPENAI_API_KEY, ANTHROPIC_API_KEY ou GOOGLE_API_KEY.
# Modelos são configuração (provedores descontinuam modelos): SOPHIA_MODEL_GROQ, SOPHIA_MODEL_OPENAI, ...
#
# Produção com OpenAI (só no ambiente Production da Vercel; local e Preview seguem no Groq):
# SOPHIA_LLM_PROVIDER=openai
# SOPHIA_MODEL_OPENAI=gpt-6-luna
# OPENAI_API_KEY=
# Mantenha GROQ_API_KEY também em produção: a transcrição do áudio (Whisper) continua no Groq.
#
# Busca na web das IAs (na OpenAI é cobrada à parte). Desligada sem esta variável.
# SOPHIA_BUSCA_WEB=1
# Esforço de raciocínio da OpenAI (none, low, medium, high). Sem a variável, usa o padrão do modelo.
# SOPHIA_RACIOCINIO_OPENAI=low
# Preço em US$ por milhão de tokens "entrada,entrada_cache,saida" para GET /consumo/{caso} mostrar
# o custo do caso. gpt-6-luna:
# SOPHIA_PRECO_IA_USD=0.10,0.01,0.50
