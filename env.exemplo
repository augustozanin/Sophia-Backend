# Copie este arquivo para backend/.env e preencha localmente.
# Não coloque usuário, senha ou URI real neste exemplo.
MONGODB_URI=
# Login com Google: o "ID do cliente" OAuth (tipo "Aplicativo da Web") do Google Cloud.
# É o mesmo valor de GOOGLE_CLIENT_ID no front. Não é segredo, mas sem ele o login
# com Google fica desligado (503). Aceita mais de um id separado por vírgula.
GOOGLE_CLIENT_ID=

# OpenAI: obrigatória. Em produção tudo usa a OpenAI: transcrição do áudio, revisão do texto,
# análise preliminar, chat e minutas (chave só no servidor, nunca no navegador).
OPENAI_API_KEY=
# Provedor do texto: openai (padrão) | groq | anthropic | google. A chave é <PROVEDOR>_API_KEY.
SOPHIA_LLM_PROVIDER=openai
# SOPHIA_MODEL_OPENAI=gpt-4.1
# Modelo da transcrição. Padrão: whisper-1 (transcreve o áudio inteiro). Os gpt-4o-transcribe e
# gpt-4o-mini-transcribe cortam reuniões longas (num teste de 16 min, pararam em 80% do áudio).
# SOPHIA_MODELO_TRANSCRICAO=whisper-1
# Modelos são configuração (provedores descontinuam modelos): SOPHIA_MODEL_OPENAI, ...

# Groq: opcional e só fora da Vercel, para testar na máquina sem a chave da OpenAI (transcrição
# e, com SOPHIA_LLM_PROVIDER=groq, o texto). Em produção a transcrição nunca usa a Groq.
# GROQ_API_KEY=
# SOPHIA_WHISPER_MODEL=whisper-large-v3-turbo
#
# Busca na web das IAs (na OpenAI é cobrada à parte). Desligada sem esta variável.
# SOPHIA_BUSCA_WEB=1
# Sites liberados para a busca (até 100; subdomínios entram junto). Sem a variável, usa a lista
# de analise/busca_web.py: tribunais, legislação, gov.br, MP, OAB e sites jurídicos secundários.
# SOPHIA_BUSCA_DOMINIOS=stf.jus.br,stj.jus.br,planalto.gov.br
# Esforço de raciocínio da OpenAI (none, low, medium, high). Sem a variável, usa o padrão do modelo.
# SOPHIA_RACIOCINIO_OPENAI=low
# Preço em US$ por milhão de tokens "entrada,entrada_cache,saida" para GET /consumo/{caso} mostrar
# o custo do caso. 4º valor opcional: US$ por mil pesquisas na web (OpenAI: 10). gpt-6-luna:
# SOPHIA_PRECO_IA_USD=0.10,0.01,0.50,10

# Acompanhamento de prazos: API pública do DJEN (CNJ), sem chave. Só troque para testes.
# DJEN_API_URL=https://comunicaapi.pje.jus.br/api/v1/comunicacao
